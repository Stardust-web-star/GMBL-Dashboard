rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Meter real-time synchronization collection
    match /meter_updates/{meterId} {
      allow read: if true;
      allow write: if true;
    }

    // General app state metadata
    match /sync_state/{stateId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
