rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Meter real-time synchronization collection (per-meter updates)
    match /meter_updates/{meterId} {
      allow read, write: if true;
    }

    // Synchronized master dataset (full master data chunks across Google AI Studio & Vercel)
    match /master_dataset/{chunkId} {
      allow read, write: if true;
    }

    // General app sync state metadata (version, counts, timestamps)
    match /sync_state/{stateId} {
      allow read, write: if true;
    }

    // User accounts collection
    match /user_accounts/{userId} {
      allow read, write: if true;
    }
  }
}

